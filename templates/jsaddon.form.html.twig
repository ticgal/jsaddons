{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
    {{ fields.sliderField('is_active', item.fields['is_active'], __('Active')) }}
    {{ fields.sliderField('login_only', item.fields['login_only'] ?? 0, __('Load only on the login page')) }}
    {{ fields.textField('key', item.fields['key'], __('Key')) }}
    <div class="alert alert-warning mb-0">
        <i class="ti ti-alert-triangle me-1"></i>
        {{ __('If "Load only on the login page" is disabled, the code of this third-party service runs inside GLPI with access to your session.') }}
    </div>
{% endblock %}
